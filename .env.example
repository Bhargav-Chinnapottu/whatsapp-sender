# Copy to ".env" and fill in. docker-compose reads this automatically.
# NEVER commit the real .env (it's already covered by .gitignore).

# Username for the login prompt (default: admin)
APP_USER=admin

# Strong password required to access the app when exposed publicly.
# Generate one, e.g.:  openssl rand -base64 24
APP_PASSWORD=change-me-to-a-long-random-string
